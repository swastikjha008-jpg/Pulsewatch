{
  "name": "pulsewatch",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@pulsewatch/web",
    "dev:dashboard": "turbo run dev --filter=@pulsewatch/dashboard",
    "dev:backend": "turbo run dev --filter=@pulsewatch/api --filter=@pulsewatch/worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @pulsewatch/db run generate",
    "db:migrate": "pnpm --filter @pulsewatch/db run migrate",
    "db:migrate:deploy": "pnpm --filter @pulsewatch/db run migrate:deploy",
    "db:studio": "pnpm --filter @pulsewatch/db run studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
