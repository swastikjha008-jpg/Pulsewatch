# Copy this file to .env in: packages/db/.env, apps/api/.env, apps/worker/.env
# (each process loads its own .env from its working directory)
DATABASE_URL="postgresql://pulsewatch:pulsewatch@localhost:5432/pulsewatch?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=4000
WORKER_CONCURRENCY=10
NODE_ENV=development
# Comma-separated list of allowed origins for apps/api's CORS. Unset = allow
# all (fine for local dev). In production, set to your web + dashboard URLs:
# CORS_ORIGIN="https://pulsewatch.io,https://app.pulsewatch.io"

# Frontend env — copy into apps/web/.env.local and apps/dashboard/.env.local
# NEXT_PUBLIC_APP_URL=http://localhost:3001   (apps/web — where "Start Monitoring" redirects)
# NEXT_PUBLIC_API_URL=http://localhost:4000   (apps/dashboard — the API above)
