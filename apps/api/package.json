{
  "name": "@pulsewatch/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pulsewatch/db run generate && tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "pnpm --filter @pulsewatch/db run generate && tsc --noEmit"
  },
  "dependencies": {
    "@pulsewatch/db": "workspace:*",
    "@pulsewatch/queue": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
